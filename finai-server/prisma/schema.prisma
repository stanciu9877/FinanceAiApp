// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Question {
  id        String   @id @default(uuid())
  userId    String
  question  String
  answer    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Stock {
  id      Int      @id @default(autoincrement())
  symbol  String
  name    String
  price   Float
  date    DateTime
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  question      String
  name          String?
  createdAt     DateTime @default(now())
  preferences   Preference[]
  questions     Question[]
  adviceEntries Advice[]
}

model Preference {
  id      Int    @id @default(autoincrement())
  stock   String
  userId  String
  user    User   @relation(fields: [userId], references: [id])
}

model Advice {
  id      Int      @id @default(autoincrement())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  content String
  date    DateTime @default(now())
}